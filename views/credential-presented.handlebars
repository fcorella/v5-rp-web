<body>

<script type="module">

import {
    jsonUtilsHex2Object
} from "./json-utils.js";

const attributes_hex = "{{attributes_hex}}";
const attributes_object = jsonUtilsHex2Object(attributes_hex);
const afterAttributes = document.getElementById('afterAttributes');
for (const key in attributes_object) {
    const value = attributes_object[key];
    const attrRow = `
      <div class="row">
        <div class="col-sm-2 offset-sm-1 text-end">${key}:</div>
        <div class="col-sm-2">${value}</div>
      </div>`;
    afterAttributes.insertAdjacentHTML('beforeBegin',attrRow);
};

</script>

<div class="container">

  <div class="row mb-1">
     <div class="col-sm-12 text-center">
       <i>Driver's License Credential Demo</i>
     </div>
  </div>

  <div class="row mb-1">
     <div class="col-sm-12 text-center">
      <h5>Bhutan Rental Cars Agency</h5>
    </div>
  </div>

  <div class="row mb-3">
     <div class="col-sm-12 text-center">
       You are logged in as {{username}} &mdash; <a href="/logout">Log out.</a>
    </div>
  </div>

  <div class="row mb-3">
     <div class="col-sm-12 text-center">
      <h2>Credential presented</h2>
    </div>
  </div>

  <div class="row mb-1">
    <div class="col-sm-12 text-start">
      A digital driver's license credential has been presented with
      the following mDL attributes:
    </div>
  </div>

  <div class="row mt-3 mb-2" id="afterAttributes">
    <div class="col-sm-12 text-start">
      You have been registered as {{username}}.  Those attributes
      have been placed in your profile and you are now logged in.
    </div>
  </div>

  <div class="row mb-2">
    <div class="col-sm-12 text-start">
      <a href="/profile">Go to your profile</a>
    </div>
  </div>

  <div class="row mb-2">
    <div class="col-sm-12 text-start">
      <a href="/home-page.html">Go to your home page</a>
    </div>
  </div>

</div
      
      
</body>